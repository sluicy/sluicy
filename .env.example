# Copy to .env and adjust. Every app reads the same file from the repo root.
DATABASE_URL=postgres://sluicy:sluicy@localhost:5432/sluicy
API_PORT=8787
WEB_PORT=5173
# Where the signed-in app lives (app.{domain} in production). Magic links and the landing's "Sign in" point here.
APP_URL=http://localhost:5173
# Who may sign in: "closed" (default) allows existing accounts and the very first signup, who becomes owner. "open" allows anyone.
REGISTRATION=closed
# Magic-link sign-in needs an email transport. SMTP is the baseline; Resend is optional. With neither set, dev prints the link to the console.
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM="Sluicy <sign-in@sluicy.dev>"
# Production only: path to the built web app (apps/web/dist) for the API to serve at APP_URL.
WEB_DIST=
# Optional. Without it, model-backed features (attribute tagging, slugs, briefs) fall back to manual entry.
ANTHROPIC_API_KEY=
