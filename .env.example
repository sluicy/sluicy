# Copy to .env and adjust. Every app reads the same file from the repo root.
DATABASE_URL=postgres://sluicy:sluicy@localhost:5432/sluicy
API_PORT=8787
WEB_PORT=5173
# Magic-link sign-in needs an email transport. SMTP is the baseline; Resend is optional.
SMTP_URL=
RESEND_API_KEY=
# Optional. Without it, model-backed features (attribute tagging, slugs, briefs) fall back to manual entry.
ANTHROPIC_API_KEY=
