{
  "openapi": "3.1.0",
  "info": {
    "title": "Sluicy API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "isOwner": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "isOwner"
        ]
      },
      "VerifyError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid",
              "expired",
              "used",
              "closed"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Email a one-time sign-in link",
        "description": "Sign-in and sign-up are the same flow: the first verified email creates the Account. Answers 202 for any well-formed email, whether or not a mail went out, so callers cannot learn which emails have Accounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "founder@example.com"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted. A link is on its way if the policy allows this email."
          },
          "400": {
            "description": "Malformed email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Consume a sign-in token and open a session",
        "description": "The emailed link lands on the app, which POSTs the token here. A POST, not a GET, so a mail gateway prefetching the link cannot consume the token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. The session cookie is set.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Token refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke the session and clear the cookie",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in Account",
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
